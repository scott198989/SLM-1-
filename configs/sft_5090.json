{
  "model_config": "configs/model_1b.json",
  "tokenizer": "data/tokenizer.json",
  "dataset": "data/sft-train",
  "validation_dataset": "data/sft-validation",
  "init_checkpoint": "runs/pretrain-1b-pilot/last.pt",
  "output_dir": "runs/sft-1b-pilot",
