{
  "model_config": "configs/model_1b.json",
  "tokenizer": "data/tokenizer.json",
  "dataset": "data/pretrain-train",
  "validation_dataset": "data/pretrain-validation",
  "output_dir": "runs/pretrain-1b-pilot",
  "stage": "pretrain",
  "steps": 10000,
  "batch_size": 1,
  "gradient_accumulation": 16,
  "learning_rate": 0.0001,
  "min_lr_ratio": 0.1,
  "warmup_steps": 500,
  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "seed": 42,
  "precision": "bf16",
  "device": "cuda",
  "checkpoint_every": 250,
  "evaluate_every": 100,
  "validation_batches": 16,
  "gradient_checkpointing": true,
  "loop_min": 1,
  "loop_max": 4,
  "aux_weight": 0.0,
  "intermediate_weight": 0.0,
  "max_temperature_c": 83.0,
  "max_run_seconds": 14400,
  "allow_fixture_data": false
}
