{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineage",
    "immutable_source_hash",
    "exact_location",
    "privacy_pass",
    "source_complete",
    "provenance",
    "rights",
    "rights_evidence_ref",
    "source_evidence_ref",
    "fidelity_pass",
    "fidelity_review_ref",
    "visual_dependencies_resolved",
    "family_isolation_pass",
    "family_manifest_ref",
    "question_complete",
    "answer_verified",
    "answer_review_ref",
    "units_assumptions_checked",
    "assistant_mask_verified",
    "citation_hash_offsets_verified",
    "independent_heldout",
    "grader_verified",
    "private_test_destination",
    "release_manifest_verified",
    "release_artifact_hash_verified"
  ],
  "properties": {
