      "type": "boolean"
    },
    "immutable_source_hash": {
      "type": "boolean"
    },
    "exact_location": {
      "type": "boolean"
    },
    "privacy_pass": {
      "type": "boolean"
    },
    "source_complete": {
      "type": "boolean"
    },
    "provenance": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "PARTIAL",
        "UNKNOWN",
        "CONFLICTING",
        "NOT_APPLICABLE"
      ]
    },
    "rights": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "PARTIAL",
        "UNKNOWN",
        "CONFLICTING",
        "NOT_APPLICABLE"
      ]
    },
    "rights_evidence_ref": {
      "type": "string"
    },
    "source_evidence_ref": {
      "type": "string"
    },
    "fidelity_pass": {
      "type": "boolean"
    },
    "fidelity_review_ref": {
      "type": "string"
    },
    "visual_dependencies_resolved": {
      "type": "boolean"
    },
    "family_isolation_pass": {
      "type": "boolean"
    },
    "family_manifest_ref": {
      "type": "string"
    },
    "question_complete": {
      "type": "boolean"
    },
    "answer_verified": {
      "type": "boolean"
    },
    "answer_review_ref": {
      "type": "string"
    },
    "units_assumptions_checked": {
      "type": "boolean"
    },
    "assistant_mask_verified": {
      "type": "boolean"
    },
    "citation_hash_offsets_verified": {
      "type": "boolean"
    },
    "independent_heldout": {
      "type": "boolean"
    },
    "grader_verified": {
      "type": "boolean"
    },
    "private_test_destination": {
      "type": "boolean"
    },
    "release_manifest_verified": {
      "type": "boolean"
    },
    "release_artifact_hash_verified": {
      "type": "boolean"
    }
